# Airtable (server-only: never prefix with NEXT_PUBLIC_, never commit real values).
# Personal access token with data.records:read + data.records:write on the site's base only.
AIRTABLE_PAT=
# Base id, starts with "app".
AIRTABLE_BASE_ID=

# Test-only: point the site at a local mock Airtable. Leave unset in Vercel.
# AIRTABLE_API_URL=http://localhost:4010
# AIRTABLE_CONTENT_URL=http://localhost:4010
